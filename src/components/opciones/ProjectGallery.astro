---
interface Props {
  name: string;
  images: string[];
}

const { name, images } = Astro.props;
---

<div class="project-gallery" data-project={name} data-images={JSON.stringify(images)}>
  <div class="gallery-preview">
    <button type="button" class="gallery-open" aria-label={`Ampliar imágenes de ${name}`}>
      <img src={images[0]} alt={`${name}, imagen 1 de ${images.length}`} loading="lazy" decoding="async" />
      <span class="gallery-expand" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M8 4H4v4m12-4h4v4M4 16v4h4m12-4v4h-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Ampliar
      </span>
    </button>
    {images.length > 1 && (
      <>
        <button type="button" class="gallery-arrow gallery-previous" aria-label={`Imagen anterior de ${name}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="gallery-arrow gallery-next" aria-label={`Imagen siguiente de ${name}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </>
    )}
    <span class="gallery-count" aria-live="polite">1 / {images.length}</span>
  </div>
</div>

<style>
  .gallery-preview {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 0.9rem;
    background: rgb(var(--c-bg-100));
    touch-action: pan-y;
  }

  .gallery-open {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }

  .gallery-open img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .gallery-expand, .gallery-count, .gallery-arrow {
    position: absolute;
    color: #fff;
    background: rgba(15, 28, 46, 0.82);
    backdrop-filter: blur(8px);
  }

  .gallery-expand {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.45rem 0.65rem;
    border-radius: 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .gallery-expand svg { width: 0.9rem; height: 0.9rem; }

  .gallery-count {
    bottom: 0.75rem;
    right: 0.75rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .gallery-arrow {
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    transform: translateY(-50%);
    transition: background 180ms ease;
  }

  .gallery-previous { left: 0.65rem; }
  .gallery-next { right: 0.65rem; }
  .gallery-arrow svg { width: 1.15rem; height: 1.15rem; }
  .gallery-arrow:hover { background: rgba(31, 58, 95, 0.95); }
  .gallery-open:focus-visible, .gallery-arrow:focus-visible { outline: 3px solid rgb(var(--c-accent-200)); outline-offset: -3px; }

  @media (hover: hover) {
    .gallery-open:hover img { transform: scale(1.035); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-open img, .gallery-arrow { transition: none; }
    .gallery-open:hover img { transform: none; }
  }
</style>
