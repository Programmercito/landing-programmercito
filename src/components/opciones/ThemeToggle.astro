---
// Botón para alternar entre tema claro y oscuro.
---

<button
    id="theme-toggle"
    type="button"
    title="Cambiar tema"
    aria-label="Cambiar tema"
    class="theme-toggle group inline-flex items-center justify-center
               p-2.5 rounded-xl
               bg-bg-200/60 border border-primary-200/20 backdrop-blur-sm
               text-text-200
               transition-all duration-400
               hover:bg-primary-100/40 hover:border-primary-300/40 hover:text-accent-200
               hover:scale-110 hover:shadow-[0_0_20px_rgba(61,90,128,0.3)]"
>
    <!-- Luna: visible en modo oscuro (clic cambia a claro) -->
    <svg
        class="theme-icon-moon w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
    >
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
        ></path>
    </svg>
    <!-- Sol: visible en modo claro (clic cambia a oscuro) -->
    <svg
        class="theme-icon-sun hidden w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
    >
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36 6.36l-1.42-1.42M7.05 7.05L5.64 5.64m12.72 0l-1.41 1.41M7.05 16.95l-1.41 1.41M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"
        ></path>
    </svg>
</button>

<style>
    /* Modo oscuro: mostrar luna */
    :global(html:not(.light)) .theme-icon-moon {
        display: block;
    }
    :global(html:not(.light)) .theme-icon-sun {
        display: none;
    }

    /* Modo claro: mostrar sol */
    :global(html.light) .theme-icon-moon {
        display: none;
    }
    :global(html.light) .theme-icon-sun {
        display: block;
    }
</style>

<script is:inline>
    (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;

        btn.addEventListener('click', function () {
            var isLight = document.documentElement.classList.toggle('light');
            try {
                localStorage.setItem('theme', isLight ? 'light' : 'dark');
            } catch (e) {}
            window.dispatchEvent(new CustomEvent('themechange', { detail: { light: isLight } }));
        });
    })();
</script>
