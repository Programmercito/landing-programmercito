---
interface Props {
    title?: string;
}
const { title } = Astro.props;
---

<div
    title={title}
    class="bg-bg-200 shadow-2xl shadow-black/40 mr-1 text-text-100 font-bold py-2 px-2 rounded-xl transition-all duration-300 select-none hover:bg-bg-100 hover:scale-110 hover:shadow-[0_8px_32px_0_rgba(0,0,0,0.35)]"
>
    <slot />
</div>
