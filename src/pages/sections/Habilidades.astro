---
import TitleSection from "../../components/opciones/TitleSection.astro";
import Section from "../../components/Section.astro";
import habilidades from "../../data/habilidades.json";
import Adf from "../../components/icons/Adf.astro";
import Angular from "../../components/icons/Angular.astro";
import Cicd from "../../components/icons/Cicd.astro";
import Devops from "../../components/icons/Devops.astro";
import Docker from "../../components/icons/Docker.astro";
import Fullstack from "../../components/icons/Fullstack.astro";
import Git from "../../components/icons/Git.astro";
import Java from "../../components/icons/Java.astro";
import Javascript from "../../components/icons/Javascript.astro";
import Kubernetes from "../../components/icons/Kubernetes.astro";
import Microservices from "../../components/icons/Microservices.astro";
import Mysql from "../../components/icons/Mysql.astro";
import Oracle from "../../components/icons/Oracle.astro";
import Php from "../../components/icons/Php.astro";
import Redis from "../../components/icons/Redis.astro";
import Scrum from "../../components/icons/Scrum.astro";
import Softarchi from "../../components/icons/Softarchi.astro";
import Sprintboot from "../../components/icons/Sprintboot.astro";
import Sql from "../../components/icons/Sql.astro";
import Sqlserver from "../../components/icons/Sqlserver.astro";
import Svn from "../../components/icons/Svn.astro";
import Typescript from "../../components/icons/Typescript.astro";
import Rest from "../../components/icons/Rest.astro";

const iconComponents = {
    Adf,
    Angular,
    Cicd,
    Devops,
    Docker,
    Fullstack,
    Git,
    Java,
    Javascript,
    Kubernetes,
    Microservices,
    Mysql,
    Oracle,
    Php,
    Redis,
    Scrum,
    Softarchi,
    Sprintboot,
    Sql,
    Sqlserver,
    Svn,
    Typescript,
    Rest,
};
---

<Section id="habilidades">
    <div class="order-2 md:order-1 text-center md:text-left w-full">
        <div class="reveal">
            <TitleSection>Habilidades</TitleSection>
        </div>

        <div class="reveal stagger-2 p-4 sm:p-6 rounded-2xl bg-bg-200/40 backdrop-blur-sm shadow-lg w-full">
            <ul class="skills-grid">
                {
                    habilidades.map((habilidad) => {
                        const Icon =
                            iconComponents[
                                habilidad.icon as keyof typeof iconComponents
                            ];
                        return (
                            <li class="skill-item">
                                <div class="skill-card">
                                    <div class="skill-icon" aria-hidden="true">
                                        {Icon && <Icon />}
                                    </div>
                                    <span class="skill-name">{habilidad.name}</span>
                                </div>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </div>
</Section>

<style>
    .skills-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .skill-item {
        width: 6.5rem;
        perspective: 700px;
    }

    .skill-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.8rem;
        min-height: 8rem;
        padding: 0.9rem 0.35rem;
        border-radius: 1rem;
        transform-style: preserve-3d;
        background:
            radial-gradient(ellipse at 50% 0%, rgb(var(--c-primary-300) / 0.09), transparent 70%),
            rgb(var(--c-bg-100) / 0.45);
        transition: transform 200ms ease, background 200ms ease, box-shadow 200ms ease;
    }

    .skill-icon {
        position: relative;
        display: grid;
        place-items: center;
        width: 3.75rem;
        height: 3.75rem;
        padding: 0.65rem;
        border-radius: 1.15rem;
        perspective: 400px;
        color: rgb(var(--c-primary-300));
        background: linear-gradient(145deg, rgb(var(--c-primary-300) / 0.16), rgb(var(--c-primary-300) / 0.03));
        transition: transform 250ms ease, box-shadow 250ms ease;
    }

    .skill-icon :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 3px 6px rgb(var(--c-primary-300) / 0.18));
        animation: skill-float 3.6s ease-in-out infinite;
        transition: filter 250ms ease;
    }

    .skill-item:nth-child(4n + 2) .skill-icon :global(svg) {
        animation-delay: -0.9s;
    }

    .skill-item:nth-child(4n + 3) .skill-icon :global(svg) {
        animation-delay: -1.8s;
    }

    .skill-item:nth-child(4n + 4) .skill-icon :global(svg) {
        animation-delay: -2.7s;
    }

    @keyframes skill-float {
        0%, 100% {
            transform: translateY(0) rotateY(-15deg);
        }
        50% {
            transform: translateY(-7px) rotateY(15deg);
        }
    }

    .skill-name {
        position: relative;
        color: rgb(var(--c-text-100));
        font-size: 0.7rem;
        font-weight: 600;
        line-height: 1.2;
        text-align: center;
        overflow-wrap: anywhere;
        transition: transform 250ms ease;
    }

    @media (hover: hover) {
        .skill-card:hover {
            transform: translateY(-5px) rotateX(7deg) rotateY(-9deg);
            box-shadow: 0 12px 28px rgb(var(--c-primary-100) / 0.2);
        }

        .skill-card:hover .skill-icon {
            transform: translateZ(18px) scale(1.08);
            box-shadow: 0 0 24px rgb(var(--c-primary-300) / 0.2);
        }

        .skill-card:hover .skill-name {
            transform: translateZ(9px);
        }

        .skill-card:hover .skill-icon :global(svg) {
            filter: drop-shadow(0 0 8px rgb(var(--c-primary-300) / 0.45));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .skill-card,
        .skill-icon,
        .skill-name,
        .skill-icon :global(svg) {
            transition: none;
        }

        .skill-icon :global(svg) {
            animation: none;
        }

        .skill-card:hover,
        .skill-card:hover .skill-icon,
        .skill-card:hover .skill-name {
            transform: none;
        }
    }
</style>
