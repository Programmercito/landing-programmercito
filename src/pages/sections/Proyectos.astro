---
import BordeadoIcon from "../../components/opciones/BordeadoIcon.astro";
import Chip from "../../components/opciones/Chip.astro";
import ProjectGallery from "../../components/opciones/ProjectGallery.astro";
import ProjectImageViewer from "../../components/opciones/ProjectImageViewer.astro";
import TitleSection from "../../components/opciones/TitleSection.astro";
import Section from "../../components/Section.astro";
import links from "../../data/proyectos.json";
import CodeIcon from "../../components/icons/CodeIcon.astro";
import DeployIcon from "../../components/icons/DeployIcon.astro";
---

<Section id="proyectos">
  <div class="order-2 md:order-1 text-center md:text-left w-full">
    <div class="reveal">
      <TitleSection>Proyectos</TitleSection>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 items-stretch w-full">
      {
        links.map((link, idx) => (
          <div class={`w-full h-full flex reveal stagger-${(idx % 6) + 1} animation-delay-${idx * 100}`}>
            <div class="project-card flex flex-col rounded-2xl w-full h-full overflow-hidden group">
              <div class="p-4 sm:p-5 pb-3">
                <div class="flex justify-center mb-2">
                  <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-gradient text-center">{link.name}</h3>
                </div>
                <p class="text-left leading-relaxed tracking-wide mb-3 sm:mb-4 text-text-200/80 text-xs sm:text-sm">
                  {link.description}
                </p>
                {link.tech && link.tech.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 sm:gap-2 justify-center mb-3 sm:mb-4">
                    {link.tech.map((tec) => <Chip text={tec} />)}
                  </div>
                )}
              </div>

              {link.images && link.images.length > 0 && (
                <div class="relative px-4 sm:px-5">
                  <ProjectGallery name={link.name} images={link.images} />
                </div>
              )}

              <div class="mt-auto" />
              <div class="p-4 sm:p-5 pt-3 sm:pt-4 flex flex-col items-center justify-center gap-2 sm:gap-3 sm:flex-row sm:justify-center">
                <BordeadoIcon link={link.url} target="_self">
                  <CodeIcon />
                  Código
                </BordeadoIcon>
                {link.despliegue && (
                  <BordeadoIcon link={link.despliegue}>
                    <DeployIcon />
                    Demo
                  </BordeadoIcon>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <ProjectImageViewer />
</Section>

<style>
  .project-card {
    background: linear-gradient(145deg, rgb(var(--c-bg-200) / 0.9) 0%, rgb(var(--c-bg-100) / 0.95) 100%);
    border: 1px solid rgb(var(--c-primary-300) / 0.15);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.3),
      0 2px 4px -1px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .project-card:hover {
    transform: translateY(-8px) scale(1.01);
    border-color: rgb(var(--c-primary-300) / 0.4);
    box-shadow:
      0 20px 40px -10px rgba(31, 58, 95, 0.5),
      0 10px 20px -5px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 0 40px rgb(var(--c-accent-100) / 0.2);
  }

  .animation-delay-0 { animation-delay: 0ms; }
  .animation-delay-100 { animation-delay: 100ms; }
  .animation-delay-200 { animation-delay: 200ms; }
  .animation-delay-300 { animation-delay: 300ms; }
  .animation-delay-400 { animation-delay: 400ms; }
  .animation-delay-500 { animation-delay: 500ms; }
  .animation-delay-600 { animation-delay: 600ms; }
  .animation-delay-700 { animation-delay: 700ms; }
  .animation-delay-800 { animation-delay: 800ms; }
  .animation-delay-900 { animation-delay: 900ms; }

  @media (prefers-reduced-motion: reduce) {
    .project-card { transition: none; }
    .project-card:hover { transform: none; }
  }
</style>
